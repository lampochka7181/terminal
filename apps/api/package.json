{
  "name": "@degen/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist node_modules",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "db:push": "drizzle-kit push:pg",
    "db:indexes": "tsx src/scripts/apply-db-indexes.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "init-protocol": "tsx src/scripts/init-protocol.ts",
    "init-markets": "tsx src/scripts/init-markets.ts",
    "setup-fee-recipient": "tsx src/scripts/setup-fee-recipient.ts",
    "setup-mm-delegation": "tsx src/scripts/setup-mm-delegation.ts",
    "setup-lending-delegation": "tsx src/scripts/setup-lending-delegation.ts",
    "query-fee-revenue": "tsx src/scripts/query-fee-revenue.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@degen/types": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@noble/hashes": "^2.0.1",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.91.0",
    "bs58": "^5.0.0",
    "bullmq": "^5.67.3",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "prom-client": "^15.1.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "drizzle-kit": "^0.20.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
