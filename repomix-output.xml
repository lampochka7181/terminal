#!/usr/bin/env node
/**
 * Log Wipe Script
 *
 * Removes all log files from apps/api/logs/ before a clean test run.
 * Usage: node scripts/wipe-logs.mjs
 */

import { rmSync, existsSync, mkdirSync } from 'fs';
import { join, resolve } from 'path';

