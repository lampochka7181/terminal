  console.log(`\n📊 Estimated needs:`);
  console.log(`   SOL: ${totalSolNeeded.toFixed(2)} (relayers: ${(20 * SOL_PER_RELAYER).toFixed(1)}, users: ${(NUM_TEST_USERS * SOL_PER_USER).toFixed(2)}, fees: ~0.5)`);
