export async function verifySignature(
  address: string,
  signature: string,
  message: string
): Promise<AuthVerifyResponse> {
  return apiFetch<AuthVerifyResponse>('/auth/verify', {
    method: 'POST',
    body: JSON.stringify({ address, signature, message }),
  });
}

