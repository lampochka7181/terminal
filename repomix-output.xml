-- Processed jobs table (for idempotency)
CREATE TABLE IF NOT EXISTS processed_jobs (
  idempotency_key VARCHAR(128) PRIMARY KEY,
  tx_sig VARCHAR(88),
  completed_at TIMESTAMP DEFAULT NOW()
);
```

