export type Asset = 'BTC' | 'ETH' | 'SOL';
export type Timeframe = '1m' | '5m' | '15m' | '1h' | '4h' | '24h';
export type MarketStatus = 'OPEN' | 'CLOSED' | 'RESOLVED' | 'SETTLED';
export type Outcome = 'YES' | 'NO';

export interface Market {
  id: string;
  address: string;          // On-chain PDA address
  asset: Asset;
  timeframe: Timeframe;
  strikePrice: number;
  finalPrice?: number;
  createdAt: number;
  expiryAt: number;
  resolvedAt?: number;
  settledAt?: number;
  status: MarketStatus;
  outcome?: Outcome;
  totalVolume: number;
  totalTrades: number;
